{
  "extends": "./tsconfig.json",
  "include": ["src/sdk/**/*", "tests/**/*.ts"],
  "compilerOptions": {
    "outDir": ".tmp-tests",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "module": "ESNext",
